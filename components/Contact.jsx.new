import React, { useState } from 'react';

export function Contact() {
  const [status, setStatus] = useState(null);

  const handleSubmit = (e) => {
    e.preventDefault();
    const form = e.target;
    const name = form.name.value.trim();
    const email = form.email.value.trim();
    const message = form.message.value.trim();

    if (!name || !email || !message) {
      setStatus({ type: 'error', message: 'All fields are required' });
      return;
    }

    if (!email.includes('@')) {
      setStatus({ type: 'error', message: 'Please enter a valid email' });
      return;
    }

    setStatus({ type: 'success', message: 'Thanks â€” your message has been received.' });

    form.name.value = '';
    form.email.value = '';
    form.message.value = '';
  };

  return (
    <section id="contact" className="py-24 relative max-w-7xl mx-auto px-6">
      <div className="max-w-6xl mx-auto">
        {/* CTA Section */}
        <div className="contact-cta text-center mb-16"
          style={{
            marginBottom: '1.5rem',
          }}
        >
          <h2 className="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6"
            style={{
              color: 'var(--foreground)',
              fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              fontWeight: 900,
              lineHeight: 1.1,
            }}
          >
            LET'S<span className="green-phrase"> CONNECT.</span>
          </h2>

          <p className="text-lg text-muted mb-10"
            style={{
              color: 'var(--muted)',
              fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              lineHeight: 1.7,
            }}
          >
            Have a testing challenge, opportunity, or project in mind?
          </p>
        </div>

        {/* Contact Info */}
        <div className="contact-info mb-16"
          style={{
            marginBottom: '1.5rem',
          }}
        >
          <div className="flex items-center gap-3 mb-4"
            style={{
              marginBottom: '0.75rem',
            }}
          >
            <div className="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0"
              style={{
                background: 'rgba(118, 185, 0, 0.1)',
              }}
            >
              <svg
                className="w-5 h-5 text-accent"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <path d="M2 3a1 1 0 0 1 1 1v14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h-1c-1 0-2 1-2 2v14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V6c0-1-1-2-2-2H5c-1 0-2 1-2 2v14a2 2 0 0 0 2 2h7c1 0 2-1 2-2V5c0-1-1-2-2-2H3c-1 0-2 1-2 2V3z" />
              </svg>
            </div>
            <div>
              <p className="font-medium"
                style={{
                  color: 'var(--foreground)',
                  fontFamily: 'Inter, Arial, Helvetica, sans-serif',
                }}
              >
                Coimbatore, Tamil Nadu
              </p>
              <p className="text-muted"
                style={{
                  color: 'var(--muted)',
                  fontFamily: 'Inter, Arial, Helvetica, sans-serif',
                }}
              >
                +91 95666 88434
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3 mb-4"
            style={{
              marginBottom: '0.75rem',
            }}
          >
            <div className="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0"
              style={{
                background: 'rgba(118, 185, 0, 0.1)',
              }}
            >
              <svg
                className="w-5 h-5 text-accent"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M21.5 14.23a9.953 9.953 0 0 1-2.72 1.44 8.967 8.967 0 0 0-2.03 1.84 8.936 8.936 0 0 0-2.36 1.48A7.979 7.979 0 0 0 8 16.06a7.973 7.973 0 0 0 .58 2.28 8.929 8.929 0 0 1-2.56 1.39A6.98 6.98 0 0 1 3.5 13c0-2.08 1.64-3.78 3.5-4.27a8.97 8.97 0 0 0 1.7-1.15 6.996 6.996 0 0 1 2.47-.61 6.993 6.993 0 0 1 2.63.89 6.996 6.996 0 0 1 2.46 2.23 6.984 6.984 0 0 1 1.1 3.07 5.002 5.002 0 0 1-.5 4.23zM8.93 11.3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm6.38 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-7.04 5.95a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm7.67-5.3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"
                />
              </svg>
            </div>
            <div>
              <p className="font-medium"
                style={{
                  color: 'var(--foreground)',
                  fontFamily: 'Inter, Arial, Helvetica, sans-serif',
                }}
              >
                mr8482742@gmail.com
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3"
            style={{ marginBottom: '0.75rem' }}
          >
            <div className="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0"
              style={{
                background: 'rgba(118, 185, 0, 0.1)',
              }}
            >
              <svg
                className="w-5 h-5 text-accent"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M21.5 14.23a9.953 9.953 0 0 1-2.72 1.44 8.967 8.967 0 0 0-2.03 1.84 8.936 8.936 0 0 0-2.36 1.48A7.979 7.979 0 0 0 8 16.06a7.973 7.973 0 0 0 .58 2.28 8.929 8.929 0 0 1-2.56 1.39A6.98 6.98 0 0 1 3.5 13c0-2.08 1.64-3.78 3.5-4.27a8.97 8.97 0 0 0 1.7-1.15 6.996 6.996 0 0 1 2.47-.61 6.993 6.993 0 0 1 2.63.89 6.996 6.996 0 0 1 2.46 2.23 6.984 6.984 0 0 1 1.1 3.07 5.002 5.002 0 0 1-.5 4.23zM8.93 11.3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm6.38 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-7.04 5.95a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm7.67-5.3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"
                />
              </svg>
            </div>
            <div>
              <p className="font-medium"
                style={{
                  color: 'var(--foreground)',
                  fontFamily: 'Inter, Arial, Helvetica, sans-serif',
                }}
              >
                linkedin.com/in/muthuraman-s-232047253
              </p>
            </div>
          </div>
        </div>

        {/* Buttons */}
        <div className="contact-buttons flex flex-col sm:flex-row gap-4 justify-center"
          style={{
            marginTop: '1.5rem',
            gap: '0.75rem',
          }}
        >
          <button
            className="email-btn px-6 py-3 bg-white text-accent font-medium rounded-full transition-all"
            style={{
              background: '#ffffff',
              color: '#76b900',
            }}
          >
            EMAIL ME
          </button>
          <button
            className="linkedin-btn px-6 py-3 border-2 border-white rounded-full hover:bg-white hover:text-black transition-all"
            style={{
              borderColor: '#ffffff',
              color: '#ffffff',
            }}
          >
            LINKEDIN
          </button>
        </div>

        {/* Contact Form */}
        {status && (
          <div
            className="status-msg rounded-xl p-6 mb-8"
            style={{
              background: status.type === 'success' ? 'rgba(118, 185, 0, 0.1)' : 'rgba(255, 0, 0, 0.1)',
              border: `1px ${status.type === 'success' ? 'rgba(118, 185, 0, 0.3)' : 'rgba(255, 0, 0, 0.3)'}`,
              color: status.type === 'success' ? 'rgba(118, 185, 0, 0.8)' : 'red',
            }}
          >
            {status.message}
          </div>
        }}

        <form onSubmit={handleSubmit} noValidate
          style={{ marginTop: '1.5rem' }}
        >
          <div className="mb-4"
            style={{
              marginBottom: '1.5rem',
            }}
          >
            <label className="block text-sm font-medium mb-2"
              style={{
                display: 'block',
                marginBottom: '0.5rem',
                color: 'var(--foreground)',
                fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              }}
            >
              Name
            </label>
            <input
              type="text"
              name="name"
              required
              className="contact-input w-full rounded-xl border p-4 bg-[0.05_0_0] transition-colors focus:outline-none focus:border-accent focus:shadow-lg"
              style={{
                background: 'rgba(10, 10, 10, 0.5)',
                border: '1px solid var(--muted)',
                color: '#ffffff',
                fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              }}
            />
          </div>

          <div className="mb-6"
            style={{
              marginBottom: '1.5rem',
            }}
          >
            <label className="block text-sm font-medium mb-2"
              style={{
                display: 'block',
                marginBottom: '0.5rem',
                color: 'var(--foreground)',
                fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              }}
            >
              Email
            </label>
            <input
              type="email"
              name="email"
              required
              className="contact-input w-full rounded-xl border p-4 bg-[0.05_0_0] transition-colors focus:outline-none focus:border-accent focus:shadow-lg"
              style={{
                background: 'rgba(10, 10, 10, 0.5)',
                border: '1px solid var(--muted)',
                color: '#ffffff',
                fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              }}
            />
          </div>

          <div className="mb-8"
            style={{
              marginBottom: '1.5rem',
            }}
          >
            <label className="block text-sm font-medium mb-2"
              style={{
                display: 'block',
                marginBottom: '0.5rem',
                color: 'var(--foreground)',
                fontFamily: 'Inter, Arial, Helvetica, sans-serif',
              }}
            >
              Message
            </label>
            <textarea
              name="message"
              rows={4}
              required
              className="contact-input w-full rounded-xl border p-4 bg-[0.05_0_0] resize-none transition-colors focus:outline-none focus:border-accent focus:shadow-lg"
              style={{
                background: 'rgba(10, 10, 10, 0.5)',
                border: '1px solid var(--muted)',
                color: '#ffffff',
                fontFamily: 'Inter, Arial, Helvetica, sans-serif',
                resize: 'none',
              }}
            ></textarea>
          </div>

          <button
            type="submit"
            className="submit-btn w-full py-3.5 bg-accent text-background font-medium rounded-full hover:shadow-lg hover:shadow-color transition-all"
            style={{
              background: '#76b900',
              color: '#000000',
              boxShadow: '0 4px 20px rgba(118, 185, 0, 0.3)',
            }}
          >
            Send Message
          </button>
        </form>
      </div>
    </section>
  );
}
